LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=gemini-3.1-flash-lite
TONE_PROFILE=friction_first
PERSONALIZATION_OPTIONS=3
RESEARCH_REGION=us
# Email verification is no-op/not_checked unless a provider adapter is added.
EMAIL_VERIFICATION_PROVIDER=none
EMAIL_VERIFICATION_API_KEY=
# Traffic providers are stubbed by default; do not use traffic as opener evidence without a configured provider.
TRAFFIC_PROVIDER=none
TRAFFIC_API_KEY=
APP_STORE_COUNTRY=us
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=America/New_York
MAX_PAGES_PER_COMPANY=5
REQUEST_TIMEOUT_SECONDS=15
REQUEST_DELAY_SECONDS=0.75
BROWSER_RENDERING=auto
BROWSER_WAIT_SECONDS=2
BROWSER_RETRY_ATTEMPTS=3
BROWSER_PROXY_URL=
BROWSER_USER_AGENT=
VISUAL_REVIEW=auto
ADVANCED_DETECTORS=auto
LIGHTHOUSE_REVIEW=off
PLAYWRIGHT_TRACES=flagged
REQUIRE_SCREENSHOT_OCR=true
TESSERACT_CMD=
MAX_BATCH_COST_USD=0
MAX_LLM_CALLS_PER_BATCH=0
